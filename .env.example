# Copy this file to ".env" (same folder as app.py) and edit the values.
# ".env" is ignored by git - never commit it.

# REQUIRED unless DEMO=1.
# Base URL of your Znuny/OTRS Generic Interface web service. Format:
#   https://<your-znuny-host>/otrs/nph-genericinterface.pl/Webservice/<WebServiceName>
ZNUNY_URL=https://znuny.example.org/otrs/nph-genericinterface.pl/Webservice/YourWebServiceName

# 1 = use synthetic demo data, no Znuny connection needed (any login works)
DEMO=0

# 1 (default) = also fetch every article/message of each ticket.
# 0 = skip articles: faster sync, but no message text.
FETCH_ARTICLES=1

# Safety cap: maximum number of tickets fetched in one sync
MAX_TICKETS=5000

# Local port of the web app
PORT=5000
